{
  "info": {
    "_postman_id": "grocio-auth-profile",
    "name": "Grocio Backend - Auth & Profile",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8089" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Check Phone",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"phoneNumber\": \"9999999999\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/check-phone", "host": ["{{baseUrl}}"], "path": ["api","auth","check-phone"] }
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"phoneNumber\": \"9999999999\",\n  \"name\": \"Test User\",\n  \"pin\": \"1234\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"phoneNumber\": \"9999999999\",\n  \"pin\": \"1234\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
      }
    },
    {
      "name": "Update PIN",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"phoneNumber\": \"9999999999\",\n  \"pin\": \"4321\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/update-pin", "host": ["{{baseUrl}}"], "path": ["api","auth","update-pin"] }
      }
    },
    {
      "name": "Update Profile",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\",\n  \"phoneNumber\": \"9999999999\",\n  \"email\": \"user@example.com\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/users/update/1", "host": ["{{baseUrl}}"], "path": ["api","users","update","1"] }
      }
    },
    {
      "name": "Get User",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/users/1", "host": ["{{baseUrl}}"], "path": ["api","users","1"] }
      }
    }
  ]
}
